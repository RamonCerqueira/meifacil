// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  cpfCnpj       String?   @unique
  plan          Plan      @default(FREE)
  logoUrl       String?   // URL da logomarca do usuário para recibos
  issuerName    String?   // Nome do emissor do recibo
  issuerDocument String?  // CPF/CNPJ do emissor do recibo
  issuerAddress String?   // Endereço do emissor do recibo
  openingDate   DateTime? // Data de abertura do CNPJ para cálculo de teto proporcional
  defaultSector BusinessSector @default(SERVICE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  clients      Client[]
  services     Service[]
  transactions Transaction[]
  receipts     Receipt[]
  dasPayments  DasPayment[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Client {
  id        String   @id @default(cuid())
  name      String
  email     String?
  cpfCnpj   String?
  phone     String?
  address   String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  receipts     Receipt[]
}

model Service {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  receipts     Receipt[]
}

model Transaction {
  id             String          @id @default(cuid())
  type           TransactionType
  amount         Decimal         @db.Decimal(10, 2)
  description    String
  date           DateTime
  category       String?
  businessSector BusinessSector? @default(SERVICE)
  userId         String
  clientId       String?
  serviceId      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  client  Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
}

model Receipt {
  id            String        @id @default(cuid())
  receiptNumber String        @unique
  amount        Decimal       @db.Decimal(10, 2)
  description   String
  issueDate     DateTime
  dueDate       DateTime?
  status        ReceiptStatus @default(PENDING)
  pdfUrl        String?
  userId        String
  clientId      String
  serviceId     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  client  Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
}

model DasPayment {
  id        String    @id @default(cuid())
  userId    String
  year      Int
  month     Int
  amount    Decimal   @db.Decimal(10, 2)
  dueDate   DateTime
  status    DasStatus @default(PENDING)
  pixCode   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, month])
}

enum Plan {
  FREE
  PRO
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum BusinessSector {
  SERVICE   // Serviços (ISS - 32% presunção de lucro)
  COMMERCE  // Comércio (ICMS - 8% presunção)
  INDUSTRY  // Indústria (ICMS - 8% presunção)
  TRANSPORT // Transporte (16% presunção)
}

enum ReceiptStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum DasStatus {
  PENDING
  PAID
  OVERDUE
}


